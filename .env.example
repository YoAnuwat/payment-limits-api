# Database (PostgreSQL) — ใช้ค่านี้จาก Railway Postgres service
DATABASE_URL=postgresql://user:password@host:5432/dbname

# AWS Configuration (ใช้เมื่อ STORAGE_MODE=s3)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=your-bucket-name
STORAGE_MODE=postgres
LOCAL_STORAGE_DIR=.local-storage
CURRENT_PAYMENT_LIMITS_KEY=paymentLimitsCTM.json
PAYMENT_LIMITS_UPLOAD_PREFIX=payment-limits
MAX_UPLOAD_SIZE_MB=5
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# User Credentials (สำหรับ Login UI)
# วิธีที่ 1: Multi-user (แนะนำ) - format: user1:password1,user2:password2
USERS=admin:P@ssw0rd123,admin1:Admin1@2024,admin2:Admin2@2024,admin3:Admin3@2024,admin4:Admin4@2024

# วิธีที่ 2: Single admin (legacy) - ใช้เมื่อไม่ได้ตั้ง USERS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# Server Configuration
PORT=3001

# Cache Configuration (Redis or Memory fallback)
REDIS_URL=redis://default:password@host:6379
CACHE_TTL_SECONDS=60

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_PUBLIC=100
RATE_LIMIT_MAX_API=30
RATE_LIMIT_MAX_LOGIN=5
