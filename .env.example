# Database (PostgreSQL) — ใช้ค่านี้จาก Railway Postgres service
DATABASE_URL=postgresql://user:password@host:5432/dbname

# AWS Configuration (ใช้เมื่อ STORAGE_MODE=s3)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=your-bucket-name
STORAGE_MODE=postgres
LOCAL_STORAGE_DIR=.local-storage
CURRENT_PAYMENT_LIMITS_KEY=paymentLimitsCTM.json
PAYMENT_LIMITS_UPLOAD_PREFIX=payment-limits
MAX_UPLOAD_SIZE_MB=5
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Admin Credentials (สำหรับ Login UI)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# Server Configuration
PORT=3001

# Cache Configuration
CACHE_TTL_SECONDS=60

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_PUBLIC=100
RATE_LIMIT_MAX_API=30
RATE_LIMIT_MAX_LOGIN=5
